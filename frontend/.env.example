# =====================================================================
# LAPOR SAR LITE — FRONTEND ENVIRONMENT CONFIGURATION
# =====================================================================
# Gunakan '/api' (relative path) agar bekerja otomatis di SEMUA domain:
# - Localhost (Docker Desktop): http://localhost/api
# - Server Lokal (LAN/Proxmox): http://laporsar.lan/api atau http://192.168.70.20/api
# - Domain Resmi Produksi: https://laporsar.basarnas.go.id/api
# =====================================================================

NEXT_PUBLIC_API_URL=/api

# URL backend internal untuk Server-Side Rendering (SSR) di dalam Docker
INTERNAL_BACKEND_URL=http://backend:8000

# Opsional: Kosongkan NEXT_PUBLIC_WS_URL agar WebSocket otomatis mendeteksi host browser
NEXT_PUBLIC_WS_URL=
