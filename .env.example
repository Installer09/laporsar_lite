# =====================================================================
# LAPOR SAR LITE — ENVIRONMENT CONFIGURATION
# =====================================================================
# Sistem Pelaporan Kondisi Marabahaya & Pusat Pengendali Operasi SAR
# Versi Prototipe Ringan (Cloud AI + Local Storage + Cloudflare Quick Tunnel)
# =====================================================================

PROJECT_NAME="Lapor SAR API"
VERSION="3.1.0-lite"

# ---------------------------------------------------------------------
# 1. KEAMANAN & AUTENTIKASI
# ---------------------------------------------------------------------
SECRET_KEY=laporsar-lite-secret-key-change-for-production-demo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Akun Super Admin Bawaan untuk Demonstrasi Langsung (admin / admin)
DEV_ADMIN_ENABLED=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# 2. DATABASE & CACHE (Docker Internal)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://laporsar_admin:laporsar_admin@db:5432/laporsar_master
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 3. PENYIMPANAN BERKAS LOKAL (MENGGANTIKAN MINIO)
# ---------------------------------------------------------------------
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/app/uploads

# ---------------------------------------------------------------------
# 4. KONFIGURASI AI PIHAK KETIGA (CLOUD AI MULTI-PROVIDER)
# ---------------------------------------------------------------------
# Pilih salah satu preset di bawah ini atau bandingkan performanya:

# ---------------------------------------------------------------------
# >>> PRESET A: [REKOMENDASI UTAMA] GROQ WHISPER + GEMINI FLASH <<<
# Kecepatan transkripsi suara sub-detik (<1s) & inferensi teks gratis/murah.
# ---------------------------------------------------------------------
AI_STT_PROVIDER=groq
AI_STT_MODEL=whisper-large-v3
AI_STT_API_KEY=gsk_your_groq_api_key_here

AI_LLM_PROVIDER=gemini
AI_LLM_MODEL=gemini-1.5-flash
AI_LLM_API_KEY=AIzaSy_your_gemini_api_key_here

AI_EMBED_PROVIDER=gemini
AI_EMBED_MODEL=text-embedding-004
AI_EMBED_API_KEY=AIzaSy_your_gemini_api_key_here


# ---------------------------------------------------------------------
# >>> PRESET B: FULL GROQ CLOUD (LLM + STT DALAM SATU AKUN) <<<
# Cukup 1 API Key Groq untuk seluruh fitur suara dan teks.
# (Hapus tanda komentar '#' di bawah jika ingin menggunakan preset ini)
# ---------------------------------------------------------------------
# AI_STT_PROVIDER=groq
# AI_STT_MODEL=whisper-large-v3
# AI_STT_API_KEY=gsk_your_groq_api_key_here
# AI_LLM_PROVIDER=groq
# AI_LLM_MODEL=llama-3.3-70b-versatile
# AI_LLM_API_KEY=gsk_your_groq_api_key_here


# ---------------------------------------------------------------------
# >>> PRESET C: FULL OPENAI CLOUD (GPT-4o-MINI + WHISPER-1) <<<
# Akurasi tinggi berstandar industri internasional.
# (Hapus tanda komentar '#' di bawah jika ingin menggunakan preset ini)
# ---------------------------------------------------------------------
# AI_STT_PROVIDER=openai
# AI_STT_MODEL=whisper-1
# AI_STT_API_KEY=sk-proj-your_openai_api_key_here
# AI_LLM_PROVIDER=openai
# AI_LLM_MODEL=gpt-4o-mini
# AI_LLM_API_KEY=sk-proj-your_openai_api_key_here
# AI_EMBED_PROVIDER=openai
# AI_EMBED_MODEL=text-embedding-3-small
# AI_EMBED_API_KEY=sk-proj-your_openai_api_key_here

# ---------------------------------------------------------------------
# 5. INTEGRASI BOT TELEGRAM & WHATSAPP (OPSIONAL SAAT DEMO)
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_SAR_GROUP_ID=
TELEGRAM_SECRET_TOKEN=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=LAPORSAR_VERIFY_TOKEN
WHATSAPP_APP_SECRET=
WHATSAPP_SAR_GROUP_ID=
