# Dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Caches
/coverage
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/*.pyc
**/*.pyo
**/*.pyd

# Build directories
**/build/
**/.next/
**/out/
**/*.tsbuildinfo

# IDEs & System files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pem
*.swp

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Private files (keep .env.example)
**/frontend/.env
**/frontend/.env.local
**/frontend/.env.development.local
**/frontend/.env.test.local
**/frontend/.env.production.local
**/backend/.env
**/.env
!.env.example

# Uploads & temporary media
**/uploads/
**/temp_audio/
