# =============================================================================
# SARBot v2.4 — Backend Environment Configuration Example
# =============================================================================
# Copy this file to .env and replace the values with your actual configuration.
# =============================================================================

# -------------------------
# DATABASE CONFIGURATION
# -------------------------
# PostgreSQL connection (local)
DATABASE_URL=postgresql+asyncpg://laporsar_admin:laporsar_admin@localhost:5432/laporsar_master

# Security
# [CHANGE IN PRODUCTION] Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# Development Admin Fallback
# Set DEV_ADMIN_ENABLED=false in production to disable the backdoor
DEV_ADMIN_ENABLED=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin

# Frontend URL (used for CORS and password reset links)
# [CHANGE IN PRODUCTION] e.g. https://sarbot.your-domain.com
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Integrations / Telegram
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SAR_GROUP_ID=your_telegram_group_id_here

# =============================================================================
# Integrations / WhatsApp (Meta Cloud API)
# =============================================================================
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_SAR_GROUP_ID=your_whatsapp_group_id_here

# =============================================================================
# Services (use localhost for local dev, Docker service names inside Docker)
# =============================================================================
# Local dev:  redis://localhost:6379/0
# Docker:     redis://redis:6379/0  (set via docker-compose environment:)
REDIS_URL=redis://localhost:6379/0


# Local dev:  http://localhost:11434
# Docker:     http://ollama:11434   (set via docker-compose environment:)
OLLAMA_HOST=http://localhost:11434

# =============================================================================
# AI / Models
# =============================================================================
LLM_MODEL=llama3.1
WHISPER_MODEL=karanchopda333/whisper:latest

# =============================================================================
# Object Storage / MinIO
# =============================================================================
# [CHANGE IN PRODUCTION] Use strong generated passwords
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=laporsar_admin
MINIO_SECRET_KEY=laporsar_admin
MINIO_SECURE=false
MINIO_BUCKET_ATTACHMENTS=laporsar-attachments

# =============================================================================
# SMTP Email (Password Reset)
# =============================================================================
# [CHANGE IN PRODUCTION] Configure real SMTP provider
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=noreply@sarbot.id
EMAILS_FROM_NAME=SAR-BOT System

# =============================================================================
# Weather API is handled via Open-Meteo (No API key required)
# =============================================================================
